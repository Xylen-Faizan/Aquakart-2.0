{
  "expo": {
    "name": "AquaKart",
    "slug": "aquakart",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aquakart",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/images/app_icon.jpg",
    "splash": {
      "backgroundColor": "#0A4DA2",
      "image": "./assets/images/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_icon.jpg",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.aquakart.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC8BHwgKt388mWy1gAM_cfxeBgRBpfa_aY"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AquaKart to use your location to track deliveries in real-time.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "27dc8cfc-c94d-4ac2-ac88-9fcad997cfa7"
      }
    }
  }
}
